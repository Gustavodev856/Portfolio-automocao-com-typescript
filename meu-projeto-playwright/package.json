{
  "name": "meu-projeto-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Automacao E2E da LojaQA com Playwright, TypeScript, POM, Fixtures e Data-Driven",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.0"
  }
}
